          "type": "array"
        },
        "max_duration_sec": {
          "type": "integer"
        },
        "max_size_mb": {
          "type": "integer"
        },
        "require_metadata": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ContentPart": {
      "properties": {
        "media": {
          "$ref": "#/$defs/MediaReference"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "DocumentConfig": {
      "properties": {
        "allowed_formats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extraction_mode": {
          "type": "string"
        },
        "max_pages": {
          "type": "integer"
        },
        "max_size_mb": {
          "type": "integer"
        },
        "require_metadata": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Eval": {
      "properties": {
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/MetricDef"
        },
        "params": {
          "type": "object"
        },
        "sample_percentage": {
          "type": "number"
        },
        "threshold": {
          "$ref": "#/$defs/EvalThreshold"
        },
        "trigger": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "when": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "trigger",
        "type"
      ]
    },
    "EvalThreshold": {
      "properties": {
        "operator": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FragmentRef": {
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "required"
      ]
    },
    "Governance": {
      "properties": {
        "accountable_owner": {
          "type": "string"
        },
        "approved_environments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "autonomy_level": {
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extensions": {
          "type": "object"
        },
        "foreseeable_misuse": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intended_deployment_contexts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intended_purpose": {
          "type": "string"
        },
        "operator_role": {
          "type": "string"
        },
        "requires_ai_disclosure": {
          "type": "boolean"
        },
        "risk_classification": {
          "type": "string"
        },
        "vocabularies": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ImageConfig": {
      "properties": {
        "allowed_formats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_detail": {
          "type": "string"
        },
        "max_images_per_msg": {
          "type": "integer"
        },
        "max_size_mb": {
          "type": "integer"
        },
        "require_caption": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MediaConfig": {
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioConfig"
        },
        "document": {
          "$ref": "#/$defs/DocumentConfig"
        },
        "enabled": {
          "type": "boolean"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/MultimodalExample"
          },
          "type": "array"
        },
        "image": {
          "$ref": "#/$defs/ImageConfig"
        },
        "supported_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "video": {
          "$ref": "#/$defs/VideoConfig"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "enabled"
      ]
