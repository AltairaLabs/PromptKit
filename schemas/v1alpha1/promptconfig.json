    "ObjectMeta": {
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "description": "Name of the resource"
        },
        "namespace": {
          "type": "string",
          "title": "Namespace",
          "description": "Namespace for the resource"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "title": "Labels",
          "description": "Key-value pairs for organizing resources"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "title": "Annotations",
          "description": "Additional metadata"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PackCompilation": {
      "properties": {
        "compiled_with": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "compiled_with",
        "created_at",
        "schema"
      ]
