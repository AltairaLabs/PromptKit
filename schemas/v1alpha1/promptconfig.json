    "MetricDefRange": {
      "properties": {
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ModelOverride": {
      "properties": {
        "parameters": {
          "$ref": "#/$defs/Parameters"
