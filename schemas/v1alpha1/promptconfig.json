        "caption": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "mime_type"
      ]
    },
    "MetricDef": {
      "properties": {
        "name": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/MetricDefRange"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "type": "object",
      "required": [
        "name",
        "type"
      ]
