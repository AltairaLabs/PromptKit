      "properties": {
        "avg_cost_usd": {
          "type": "number"
        },
        "max_cost_usd": {
          "type": "number"
        },
        "min_cost_usd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PackTemplateEngine": {
      "properties": {
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "syntax": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "syntax",
        "version"
      ]
