---
// The same theme layer the docs pages load, in the same order. Starlight's
// customCss only reaches Starlight pages, and a landing page is not one — so
// without this the home page and the docs of the same site disagreed on the
// Atlas mapping, the wordmark size and the border-box reset.
import '@altairalabs/atlas-tokens/index.css';
import '@altairalabs/brand/starlight-atlas.css';
import FamilyBar from '@altairalabs/brand/FamilyBar.astro';
import ProductNav from '../components/landing/ProductNav.astro';
import Hero from '../components/landing/Hero.astro';
import HowItFits from '../components/landing/HowItFits.astro';
import Performance from '../components/landing/Performance.astro';
import Capabilities from '../components/landing/Capabilities.astro';
import InstallBand from '../components/landing/InstallBand.astro';
import StreamWithTools from '../components/landing/StreamWithTools.astro';
import DiataxisMatrix from '../components/landing/DiataxisMatrix.astro';
import RepoStructure from '../components/landing/RepoStructure.astro';
import SiteFooter from '@altairalabs/brand/SiteFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PromptKit — The Go runtime for production agents</title>
    <meta
      name="description"
      content="The high-performance Go runtime and SDK for production LLM applications. Multi-provider streaming with bounded back-pressure, native MCP tools, A2A orchestration, workflow state machines, voice and multimodal — one pipeline."
    />
    <link rel="icon" href="/atlas/logo-promptkit.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://promptkit.altairalabs.ai/" />
    <!--
      Written out by hand, because this page is not a Starlight page and
      therefore inherits none of Starlight's head — so the one URL anyone
      actually pastes into Slack had no card at all. Keep these in step with
      the title and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PromptKit" />
    <meta property="og:url" content="https://promptkit.altairalabs.ai/" />
    <meta property="og:title" content="PromptKit — The Go runtime for production agents" />
    <meta
      property="og:description"
      content="The high-performance Go runtime and SDK for production LLM applications. Multi-provider streaming with bounded back-pressure, native MCP tools, A2A orchestration, workflow state machines, voice and multimodal — one pipeline."
    />
    <meta property="og:image" content="https://promptkit.altairalabs.ai/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PromptKit — the Go runtime for production agents" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="PromptKit — The Go runtime for production agents" />
    <meta
      name="twitter:description"
      content="Multi-provider streaming, native MCP tools, A2A orchestration, workflows, voice and multimodal — one Go pipeline."
    />
    <meta name="twitter:image" content="https://promptkit.altairalabs.ai/og-image.png" />
    <script is:inline>
      // Pre-hydration theme init: localStorage -> prefers-color-scheme.
      const t =
        localStorage.getItem('starlight-theme') ||
        (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <FamilyBar current="promptkit" docsHref="/sdk/" />
    <ProductNav />
    <main>
      <Hero />
      <HowItFits />
      <Performance />
      <Capabilities />
      <InstallBand />
      <StreamWithTools />
      <DiataxisMatrix />
      <RepoStructure />
    </main>
    <SiteFooter
      current="promptkit"
      logo="/atlas/logo-promptkit.svg"
      tagline="The high-performance Go runtime and SDK for production LLM applications."
      columns={[
        {
          title: 'Product',
          links: [
            { text: 'Runtime', href: '/runtime/' },
            { text: 'SDK', href: '/sdk/' },
            { text: 'Reference', href: '/runtime/reference/' },
          ],
        },
        {
          title: 'Docs',
          links: [
            { text: 'Tutorials', href: '/runtime/tutorials/' },
            { text: 'How-to guides', href: '/runtime/how-to/' },
            { text: 'Explanation', href: '/runtime/explanation/' },
          ],
        },
      ]}
    />
    <style is:global>
      html {
        background: var(--bg-app);
        color-scheme: dark light;
        overflow-x: hidden;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--bg-app);
        color: var(--text-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }
      .atlas-inner {
        max-width: 1120px;
        margin: 0 auto;
      }
      /* Let grid/flex tracks shrink below their content's intrinsic width so
         scrollable code panels scroll internally instead of widening the page. */
      main .grid > *,
      main .steps > *,
      main .cols > * {
        min-width: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
    </style>
  </body>
</html>
